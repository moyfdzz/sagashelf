{
  "name": "sagashelf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,yml,yaml}": "prettier --write"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "wrangler types && react-router typegen && node scripts/sync-tsconfig-node.mjs && tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:integration": "node scripts/integration-db.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "test:a11y": "vitest run --config vitest.a11y.config.ts && node scripts/a11y-pages.mjs",
    "check:full": "npm run check && npm run test:integration",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run check:budgets",
    "prepare": "husky",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "@clerk/backend": "^3.30.0",
    "@clerk/localizations": "^4.25.0",
    "@clerk/react-router": "^3.7.3",
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "i18next": "^26.5.12",
    "isbot": "^5.2.3",
    "lucide-react": "^1.73.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1",
    "remix-i18next": "^8.0.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "msw": "^3.0.6",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
