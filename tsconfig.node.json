{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "e2e/**/*",
    "db/**/*",
    "server/db/schema/**/*",
    "server/db/clerk-sync.ts",
    "server/db/erase-user.ts",
    "server/db/profile.ts",
    "server/db/username.ts",
    "server/db/media-store.ts",
    "server/db/media-detail.ts",
    "server/db/titles.ts",
    "server/db/library.ts",
    "server/db/viewings.ts",
    "server/db/import.ts",
    "server/media/import.ts",
    "server/library/**/*",
    "server/db/search-local.ts",
    "server/search/normalize.ts",
    "server/providers/types.ts",
    "server/account/profile-schema.ts",
    "server/account/export.ts",
    "server/account/username-schema.ts",
    "server/auth/clerk-user.ts",
    "server/auth/canonical-email.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
