/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets never go here: set them with `wrangler secret put` or in `.dev.vars` (gitignored).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagashelf",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Production lives on the apex domain and on www (a custom domain matches one exact host).
  // Cloudflare creates the DNS records and certificates when this is deployed. The Worker
  // answers www with a 301 to the apex (server/host.ts). Previews are not affected.
  "routes": [
    { "pattern": "sagashelf.app", "custom_domain": true },
    { "pattern": "www.sagashelf.app", "custom_domain": true },
  ],
  // Adding routes switches workers.dev off unless this says otherwise. It stays on until
  // the custom domain is confirmed; turning it off is a later, separate change.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
  },
  "vars": {
    "APP_ENV": "production",
    // The Clerk production instance. The publishable key and the JWT public key are public (the
    // secret key and the webhook signing secret are Workers secrets).
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc2FnYXNoZWxmLmFwcCQ",
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAtRPvSubjsb+JJPy9BFGj\nz8qsPo7puHpfAKu62iwR3L7FS5YB7+vP2h14uusJGpxrCrOBJYFrndX5F+78uWZz\nIYfmej4eUCjIVCE99eyYrYw3WNTPG0i81ITLvp7GjydQzQJSLZnakzixsknmBQ4B\nFxgHv/j64qIHRqcw/LrrcMrqlgn/pRy4+i31/H5WskBJ0f4v1wfsi/wuxzq7x6wQ\nIp0d9onW142/9ILrSdXGvt87HRdJUhVKMezemqaZZ7PvjYGjuoaDDuVvzrFxuBj2\ngzozsB9B60+eWfIqN9LhrluucMF4LXc8qQPv0jVVY/HLmek+Prv0A+2n+tfTuqSG\nFwIDAQAB\n-----END PUBLIC KEY-----",
  },
  // App-level limit for write endpoints, counted per caller and per Cloudflare location.
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
    // Searches are read-only but call paid-for or rate-limited providers, so they have their own
    // counter and do not use up the writes of the same person (SAG-15).
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Preview deployments (one per PR) get their own values and never reuse production ones.
  // Bindings are not inherited: each one is declared again here, with its own counter.
  "previews": {
    // The Clerk development instance. Both values are public (the secret key is a Workers
    // secret). Production gets its own when the production Clerk instance exists.
    "vars": {
      "APP_ENV": "preview",
      "CLERK_PUBLISHABLE_KEY": "pk_test_bGl0ZXJhdGUtaGFtc3Rlci04MjQ0LmNsZXJrLmFjY291bnRzLmRldiQ",
      "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA2er+f8L/gIqGpXhKmnjg\nl4V/OfOfwRXg0BOlCMFftbEWIhAu/ViXLRrwugrLsYY2ZlBLFGQ0hBNVdFP4xT8C\nTF9eTWF6STs96SqF6pleJQ1VSl7Z1p3FGn224Q1KbF9x189gT6aq1yr5rRg9uqy0\nfPetqLuQ2W1zEmE+Db7/yvqHGEhlGZ9xtErBtoe+pcNPF2z+a6NoppdjDFNf8KOh\nG0zq2gF8YmqHJyQb3t3bGWcqdSPYAFhiclEtmfe9B37eks74Xg3s8fWRftLHD6AT\n+nE0gORgqO4S7EfHjsr+Oo016L1mUI/QuM31x4feJztSH2w1gSoJ/SjSOBoYO7Wl\nZQIDAQAB\n-----END PUBLIC KEY-----",
    },
    "ratelimits": [
      {
        "name": "WRITE_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "SEARCH_LIMITER",
        "namespace_id": "2002",
        "simple": { "limit": 60, "period": 60 },
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
