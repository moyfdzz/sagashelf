/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets never go here: set them with `wrangler secret put` or in `.dev.vars` (gitignored).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagashelf",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "assets": {
    "binding": "ASSETS",
  },
  "vars": {
    "APP_ENV": "production",
  },
  // Preview deployments (one per PR) get their own values and never reuse production ones.
  "previews": {
    "vars": {
      "APP_ENV": "preview",
    },
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
