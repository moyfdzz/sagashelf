/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets never go here: set them with `wrangler secret put` or in `.dev.vars` (gitignored).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sagashelf",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  // Production lives on the apex domain and on www (a custom domain matches one exact host).
  // Cloudflare creates the DNS records and certificates when this is deployed. The Worker
  // answers www with a 301 to the apex (server/host.ts). Previews are not affected.
  "routes": [
    { "pattern": "sagashelf.app", "custom_domain": true },
    { "pattern": "www.sagashelf.app", "custom_domain": true },
  ],
  // Adding routes switches workers.dev off unless this says otherwise. It stays on until
  // the custom domain is confirmed; turning it off is a later, separate change.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
  },
  "vars": {
    "APP_ENV": "production",
  },
  // App-level limit for write endpoints, counted per caller and per Cloudflare location.
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // Preview deployments (one per PR) get their own values and never reuse production ones.
  // Bindings are not inherited: each one is declared again here, with its own counter.
  "previews": {
    "vars": {
      "APP_ENV": "preview",
    },
    "ratelimits": [
      {
        "name": "WRITE_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 30, "period": 60 },
      },
    ],
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
