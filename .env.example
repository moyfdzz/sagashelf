# Copy this file to .dev.vars for local development and fill in the values.
# Never commit .dev.vars or .env. Variable names only; values stay empty here.
# Production values are Workers secrets (wrangler secret put), never files.

APP_ENV=

# Cloudflare Turnstile secret key (a Workers secret in production). Needed by the first form that uses Turnstile.
TURNSTILE_SECRET_KEY=

# Neon connection string (pooled, with -pooler in the host). A Workers secret in production;
# in .dev.vars it can point to the local Docker database from `npm run db:up`.
# For the migration commands, set it in your own terminal for that one command: never in a file.
DATABASE_URL=

# Clerk keys from the dashboard (Developers > API keys). The development instance uses pk_test_/sk_test_.
# The publishable key and the JWT public key are public; the secret key is a Workers secret in production.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# The signing secret of the Clerk webhook endpoint (Configure > Webhooks), starts with whsec_.
# A Workers secret in production.
CLERK_WEBHOOK_SIGNING_SECRET=

# The TMDB "API Read Access Token" (themoviedb.org > Settings > API), a long token that starts with
# "eyJ". A Workers secret in production. Non-commercial use only (ADR-016).
TMDB_READ_ACCESS_TOKEN=

# Set to true to use Open Library for books (SAG-14). It needs no key. Leave it out in CI and
# previews so no test calls the real service. In production it is a plain variable of the Worker.
OPEN_LIBRARY_ENABLED=

# Set to true to use MangaDex for manga (SAG-66). It needs no key. Leave it out in CI and previews.
MANGADEX_ENABLED=

# Only for the integration tests. Defaults to the local Docker test database.
# The tests refuse any database that is not local and named *_test.
TEST_DATABASE_URL=
