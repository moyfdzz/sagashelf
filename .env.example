# Copy this file to .dev.vars for local development and fill in the values.
# Never commit .dev.vars or .env. Variable names only; values stay empty here.
# Production values are Workers secrets (wrangler secret put), never files.

APP_ENV=

# Cloudflare Turnstile secret key (a Workers secret in production). Needed by the first form that uses Turnstile.
TURNSTILE_SECRET_KEY=

# Neon connection string (pooled, with -pooler in the host). A Workers secret in production;
# in .dev.vars it can point to the local Docker database from `npm run db:up`.
# For the migration commands, set it in your own terminal for that one command: never in a file.
DATABASE_URL=

# Only for the integration tests. Defaults to the local Docker test database.
# The tests refuse any database that is not local and named *_test.
TEST_DATABASE_URL=
